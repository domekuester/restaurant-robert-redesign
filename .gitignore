# macOS
.DS_Store

# Bild-Werkzeuge (wird von tools/optimize-images.sh automatisch angelegt)
tools/.venv/

# Original-Fotos bleiben lokal (122+ MB – die Website braucht nur optimized/).
# Backup der Originale separat sichern, sie sind NICHT im Repo!
assets/photos/original/
node_modules/

# Claude-Code-Skills: Fremdcode bleibt lokal (2,9 MB).
# skills-lock.json wird bewusst NICHT ignoriert – damit lässt sich alles
# mit `npx skills experimental_install` wiederherstellen.
.agents/
.claude/skills/

# Browser-QA-Artefakte: Snapshots, Konsolenlogs und Screenshots, die
# Playwright bei jedem Lauf ablegt. Gehören nie ins Repository.
.playwright-mcp/
